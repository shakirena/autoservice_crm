rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthed() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isManager() {
      return hasRole('manager');
    }

    function isMechanic() {
      return hasRole('mechanic');
    }

    function isClient() {
      return hasRole('client');
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isManager();
      allow create: if isAdmin();
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if isAuthed() && (
        isAdmin() ||
        isManager() ||
        isMechanic() ||
        (isClient() && resource.data.clientId == request.auth.uid)
      );
      allow create: if isAdmin() || isManager();
      allow update: if isAdmin() || isManager() ||
        (isMechanic() && resource.data.mechanicId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /clients/{clientId} {
      allow read: if isAdmin() || isManager() || isMechanic();
      allow write: if isAdmin() || isManager();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
